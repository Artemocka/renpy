# =============================================================
#  ВЕДЬМИН ЧАС — полный сценарий
#  Хогвартс, конец XIX века
# =============================================================

# ------- ФОНЫ-ЗАГЛУШКИ (заменить на финальные арты) -------
image bg hogwarts_night   = Solid("#050a14")
image bg library_night    = Solid("#08091a")
image bg secret_room      = Solid("#0d0a1a")
image bg potions_class    = Solid("#0a1208")
image bg ror              = Solid("#100a08")
image bg great_hall       = Solid("#1a1208")
image bg east_wing        = Solid("#06060f")
image bg astronomy_tower  = Solid("#04040e")
image bg slytherin_common = Solid("#060f0a")
image bg library_day      = Solid("#1a1810")
image bg dumbledore       = Solid("#1a160a")
image bg altar_room       = Solid("#0a0008")
image bg hogwarts_dawn    = Solid("#151020")


# ------- ПЕРСОНАЖИ -------
define ev  = Character("Эвелина",   color="#a8ffcc")
define th  = Character("Теодор",    color="#80c8ff")
define co  = Character("Корнелиус", color="#ffd060")
define ma  = Character("Мэри",      color="#d0a0ff")
define se  = Character("Себастьян", color="#ff9090")

define pb  = Character("Проф. Блэк",  color="#c8c8c8")
define dir = Character("Директор",    color="#e8d080")
define ten = Character("Тень",        color="#9933cc")
define nar = Character(None,          kind=nvl)


# ------- ПЕРЕМЕННЫЕ -------

# Очки отношений (0–10)
default r_ev = 0
default r_th = 0
default r_co = 0
default r_ma = 0
default r_se = 0

# Связь с Тенью (0–100): чем выше, тем сильнее Тень влияет на героев
default shadow = 0

# Флаги сюжета
default took_book  = False   # взял ли игрок книгу сам
default know_co    = False   # раскрыта ли тайна Корнелиуса
default ally       = ""      # главный союзник (выбирается в конце Акта I)
default romance    = ""      # романтический интерес


# =============================================================
#  ПРОЛОГ: ЗОВ ИЗ ТЕМНОТЫ
# =============================================================

label start:

    scene bg hogwarts_night with fade

    nvl clear
    nar "Ноябрь. Хогвартс."
    nar "Замок дышит тревогой."
    nar "Студенты видят кошмары. Привидения избегают Восточного крыла. Филч клянётся, что слышит шаги в стенах."
    nvl clear
    nar "Пятеро. Трое из Слизерина, двое из Когтеврана. Все разные. Все ведут свою игру."
    nar "Но сегодня ночью что-то ведёт их в одно место."

    nvl clear
    scene bg library_night with dissolve

    nar "Запретная секция. Тёмная. Тихая. Холодная."
    nar "За гобеленом с изображением Ночи скрыта дверь, которую никто раньше не замечал."
    nar "Или замечал — и тут же забывал."

    nvl clear

    ev "Что вы здесь все делаете?"
    th "То же, что и ты. Ищу то, чего не должно существовать."
    co "Судьба у нас, видимо, богатая на совпадения."
    ma "Я видела это место во сне. Мы все должны были прийти."
    se "..."
    se "Голос назвал моё имя."

    nvl clear
    nar "На пюпитре посреди комнаты лежит книга."
    nar "Переплёт из чёрной кожи. Тиснёные руны. Застёжка — змея, кусающая себя за хвост."
    nar "{i}«Хроника Полуночного часа».{/i}"

    menu:
        "Взять книгу.":
            $ took_book = True
            $ shadow += 15
            nar "Рука тянется сама. Книга тёплая на ощупь — как живая."
            ev "Ты уверен?"
            th "Нет. Но разве это кого-нибудь останавливало?"
            $ r_th += 1

        "Не трогать. Это ловушка.":
            $ took_book = False
            $ shadow += 5
            nar "Никто не двигается. Тишина становится невыносимой."
            nar "Затем порыв ветра открывает книгу сам. Страницы шелестят, будто их листают невидимые пальцы."
            ma "Судьба вмешалась сама. Мы уже не можем уйти."
            $ r_ma += 1

    nvl clear
    nar "Руны на первой странице светятся тёмно-фиолетовым."
    nar "Текст проявляется медленно — будто написан кровью, которая ещё не засохла."
    nar "{i}«Пятеро голосов в самую тёмную ночь года. Пятеро сердец, пятеро теней. Ритуал ждёт.»{/i}"

    ten "Добро пожаловать."
    nvl clear
    ten "Я ждала вас очень долго."

    scene bg hogwarts_night with dissolve
    nvl clear
    nar "Голос звучит ниоткуда. Или отовсюду сразу."
    nar "Пятеро смотрят друг на друга."
    nar "Никто не уходит."

    jump act1_potions


# =============================================================
#  АКТ I: СПЛЕТЕНИЕ СУДЕБ (Сентябрь — Декабрь)
# =============================================================

label act1_potions:

    nvl clear
    scene bg potions_class with fade

    nar "{b}Акт I. Декабрь. Урок зельеварения.{/b}"
    nvl clear
    nar "Профессор Блэк, мрачный человек с тонкими пальцами и взглядом, читающим мысли, разбивает студентов на пары."

    pb "Нотар — с Роули. Вейн — с Олбрайт. Морвуд — самостоятельно."
    se "Как обычно."

    nvl clear
    nar "Эвелина и Теодор работают молча. Или пытаются."

    ev "Ты добавил слишком много лунного камня. Зелье станет нестабильным."
    th "А ты уверена, что вообще знаешь, что делаешь? Или просто повторяешь учебник?"
    ev "Учебник написан людьми, которые знают больше нас."
    th "Учебник написан людьми, которые хотели, чтобы мы думали именно так."

    nvl clear
    nar "Пауза. Эвелина смотрит на него иначе — словно видит впервые."

    ev "Ты необычно мыслишь для слизеринца."
    th "Я необычно мыслю для человека. Слизерин здесь ни при чём."

    menu:
        "Поддержать Теодора.":
            $ r_th += 2
            $ r_ev -= 1
            nar "Что-то в его словах звучит верно. Ты киваешь."
            th "Хотя бы один человек с критическим мышлением."

        "Поддержать Эвелину.":
            $ r_ev += 2
            $ r_th -= 1
            nar "Правила существуют по причине. Ты говоришь это вслух."
            ev "Спасибо. Приятно встретить кого-то разумного."

        "Промолчать.":
            nar "Ты молчишь. Оба смотрят на тебя."
            th "Мудрое решение."

    jump act1_ror


label act1_ror:

    nvl clear
    scene bg ror with dissolve

    nar "{b}Акт I. Выручай-комната.{/b}"
    nvl clear
    nar "Комната приняла форму архива. Тысячи стеклянных шаров, в каждом — клубящийся туман."

    ma "Это... сны. Чужие сны."
    co "Занятно. Комната сохраняет не вещи, а воспоминания."
    se "Это не воспоминания. Это предупреждения."

    nvl clear
    nar "Мэри идёт между рядами, не касаясь шаров."

    ma "Я вижу..."
    ma "Один из нас... стоит с другой стороны. Смотрит на остальных. Ждёт."
    ev "Предательство?"
    ma "Или выбор. Иногда они выглядят одинаково."
    se "Хватит. Нам не нужны пророчества. Нам нужны ответы."

    menu:
        "Расспросить Мэри подробнее.":
            $ r_ma += 2
            ma "Тьма и свет — слитые вместе. Чья-то рука тянется к алтарю."
            ma "Больше — нет. Туман скрывает лицо."

        "Поддержать Себастьяна — пора действовать.":
            $ r_se += 2
            se "Спасибо. Хоть кто-то мыслит практично."

        "Попытаться открыть один из шаров.":
            $ shadow += 10
            nar "Стекло холодное. Туман внутри складывается в картину."
            nar "Пятеро у алтаря. Один — лежит."
            nar "Ты быстро опускаешь шар."

    jump act1_ball


label act1_ball:

    nvl clear
    scene bg great_hall with dissolve

    nar "{b}Акт I. Зимний бал.{/b}"
    nvl clear
    nar "Великий зал украшен ледяными скульптурами и тысячами свечей. Красиво. Фальшиво."
    nar "Эвелина безупречна: платье, осанка, улыбка — всё выверено."

    co "Нотар, ты сегодня блистаешь. Жаль, твой отец не может сказать того же о своей репутации."
    ev "Что?"
    co "Все знают о проверке Министерства. Список подозреваемых — там есть одно знакомое имя."

    menu:
        "Встать между ними.":
            $ r_ev += 3
            $ r_co -= 1
            nar "— Хватит, Вейн."
            co "О-о. Рыцарь нашёлся."
            ev "Спасибо. Это было... неожиданно."

        "Отойти в сторону.":
            nar "Это не твоё дело."
            nar "Эвелина справляется сама. Но ты замечаешь, как дрожат её руки."

        "Поговорить с Корнелиусом наедине позже.":
            $ r_co += 1
            nar "В коридоре, после бала — ты догоняешь его."
            nar "— Зачем ты это сделал?"
            co "Потому что она должна знать, с кем живёт под одной крышей. Это был акт доброты."
            co "Странный, согласен."

    jump act1_marks


label act1_marks:

    nvl clear
    scene bg east_wing with dissolve

    nar "{b}Акт I. Первая жертва Тени.{/b}"
    nvl clear
    nar "Книга начинает проявляться в реальности."

    se "Смотрите."
    nar "Он закатывает рукав. На запястье — ожоги в форме рун."
    th "..."
    th "Я слышал его голос. В пустом коридоре. Отец."
    th "Он умер три года назад."

    ev "Книга нас метит."
    co "Нет. Книга нас {i}выбирает{/i}."
    ma "Это не одно и то же?"
    co "Нет."

    nvl clear
    nar "Никто не знает, что ответить."

    jump act1_climax


label act1_climax:

    nvl clear
    scene bg secret_room with dissolve

    nar "{b}Акт I. Ночь перед Рождеством.{/b}"
    nvl clear
    nar "Книга открылась сама."
    nar "Текст изменился."
    nar "Пять имён: Эвелина. Теодор. Корнелиус. Мэри. Себастьян."
    nar "Одно — зачёркнуто чернилами цвета крови."

    ma "Я знала. Я видела..."
    ev "Ритуал жертвы. Один из нас должен умереть."
    se "Никто не умрёт."
    th "Вопрос лишь в том — добровольно или нет."
    co "Интересная постановка вопроса."

    nvl clear
    nar "Паранойя входит в комнату вместе с зимним холодом."
    nar "Кому из них можно доверять?"

    menu:
        "Я доверяю Эвелине.":
            $ ally = "ev"
            $ r_ev += 5
            nar "В её глазах — страх. Но ещё — решимость."
            nar "Ты видишь человека, а не маску."

        "Я доверяю Теодору.":
            $ ally = "th"
            $ r_th += 5
            nar "Его цинизм — это щит. За ним — тот, кто слишком много потерял."

        "Я доверяю Корнелиусу.":
            $ ally = "co"
            $ r_co += 5
            nar "Он знает больше, чем говорит. Именно поэтому ты держишь его близко."

        "Я доверяю Мэри.":
            $ ally = "ma"
            $ r_ma += 5
            nar "Она видит то, что другие не замечают."
            nar "Её тихий голос — единственный, которому можно верить."

        "Я доверяю Себастьяну.":
            $ ally = "se"
            $ r_se += 5
            nar "За самоуверенностью — боль. Ты знаешь эту боль. Вы похожи."

    nvl clear
    scene bg hogwarts_night with fade
    nar "Рождественские каникулы. Замок пустеет."
    nar "Но не для них."

    jump act2_ev


# =============================================================
#  АКТ II: ТЕНИ ПРОШЛОГО (Январь — Март)
# =============================================================

label act2_ev:

    nvl clear
    scene bg library_day with fade

    nar "{b}Акт II. Январь. Эвелина.{/b}"
    nvl clear

    ev "Нет... Это невозможно."
    th "Что случилось?"
    ev "Отец. Он финансировал экспедицию за этой книгой — пятнадцать лет назад."
    ev "Он знал о ней. Он искал её намеренно."
    th "Значит, мы здесь не случайно."
    ev "Никто из нас — не случайно."

    menu:
        "Поддержать Эвелину.":
            $ r_ev += 3
            $ romance = "ev" if romance == "" else romance
            ev "Ты первый, кто смотрит на меня без подозрения."
            ev "Спасибо."

        "Спросить, знала ли она раньше.":
            $ r_ev -= 1
            ev "Нет. Я не знала."
            nar "Она отворачивается."
            ev "Я думала, ты мне веришь."

        "Сказать: это меняет всё.":
            $ shadow += 5
            th "Да. Это меняет всё."
            nar "Никто не спорит."

    jump act2_th


label act2_th:

    nvl clear
    scene bg library_day with dissolve

    nar "{b}Акт II. Теодор.{/b}"
    nvl clear
    nar "Теодор держит в руках старый дневник. Он не помнит, как тот появился среди его вещей."

    th "«Механизмы ритуала завершены. Я не герой — я орудие. Пусть кто-нибудь другой остановит то, что я начал.»"
    th "..."
    th "Отец. Ты был частью этого."

    menu:
        "Просто сесть рядом — молча.":
            $ r_th += 3
            $ romance = "th" if romance == "" else romance
            nar "Слова здесь не нужны. Ты просто садишься рядом."
            th "Не уходи. Пожалуйста."

        "Предложить сжечь дневник.":
            $ r_th += 1
            th "Нет. Мне нужно знать всё — даже если это разрушит последний образ отца."

        "Спросить про «механизмы ритуала».":
            $ r_th += 1
            $ shadow += 5
            th "Артефакты. Пять штук. Каждый привязан к одному из нас."
            th "Мой отец создал один из них."

    jump act2_co


label act2_co:

    nvl clear
    scene bg east_wing with dissolve

    nar "{b}Акт II. Корнелиус.{/b}"
    nvl clear
    nar "Корнелиус не спит уже трое суток. Тени на стенах движутся против источника света."

    ma "Корнелиус... что ты делаешь?"
    co "То, что у меня в крови."
    co "Я — потомок некроманта. Того самого. Книга признала меня наследником."
    co "Она даёт мне власть над тенями."

    $ know_co = True

    menu:
        "Это опасно. Попросить его остановиться.":
            $ r_co += 1
            $ r_ma += 1
            co "Опасно — слово для тех, кто боится."
            ma "Вот именно это меня и пугает."

        "Это невероятно. Попросить показать больше.":
            $ r_co += 2
            $ shadow += 10
            nar "Тени сгущаются вокруг его руки, принимают формы — птица, волк, человек."
            co "Они всегда слушались. Я просто не знал этого раньше."

        "Уйти — это не твоё дело.":
            nar "Ты уходишь. Но образ живых теней не отпускает."

    jump act2_ma


label act2_ma:

    nvl clear
    scene bg astronomy_tower with dissolve

    nar "{b}Акт II. Мэри.{/b}"
    nvl clear
    nar "Башня астрономии. Мэри смотрит на звёзды."

    ma "Я вижу финал каждый раз, когда засыпаю."
    ma "В первом варианте — я умираю на алтаре."
    ma "Во втором — остаюсь, но внутри живёт кто-то другой."
    ma "Я не знаю, какой хуже."

    menu:
        "Пообещать, что этого не случится.":
            $ r_ma += 3
            $ romance = "ma" if romance == "" else romance
            ma "Ты не можешь это обещать."
            nar "— Знаю. Но я могу стараться."
            ma "Этого достаточно."

        "Спросить, как изменить видение.":
            $ r_ma += 2
            ma "Видения — не приговор. Но их изменение... всегда требует цены."

        "Признаться, что тебе тоже страшно.":
            $ r_ma += 2
            ma "Я знаю. Я вижу твой страх."
            ma "Он выглядит как забота. Это красиво."

    jump act2_se


label act2_se:

    nvl clear
    scene bg slytherin_common with dissolve

    nar "{b}Акт II. Себастьян.{/b}"
    nvl clear
    nar "Гостиная Слизерина. Себастьян один — держит в руках старый медальон с гербом рода Морвуд."

    se "Зачем пришёл?"
    nar "Просто так."
    se "«Просто так» не существует."
    se "Знаешь, в чём проклятие рода Морвуд? Каждый первый сын умирает раньше срока. Мой дед. Его отец. Его отец."
    se "Мне восемнадцать. У меня нет времени."
    se "Предок участвовал в том самом ритуале. Не как жертва — как свидетель."
    se "Он выжил, но книга запомнила его имя. И передаёт расплату по наследству."

    menu:
        "Мы найдём способ без жертв.":
            $ r_se += 3
            se "Ты веришь в это?"
            nar "Ты пожимаешь плечами."
            nar "— Я верю в нас пятерых."

        "Расскажи мне всё.":
            $ r_se += 2
            $ romance = "se" if romance == "" else romance
            nar "Он говорит долго. Впервые за много месяцев — без маски."

        "Ты не должен нести это в одиночку.":
            $ r_se += 2
            se "Я всегда нёс. Так устроен мой род."
            nar "— Может, хватит?"

    jump act2_conflict


label act2_conflict:

    nvl clear
    scene bg secret_room with dissolve

    nar "{b}Акт II. Март. Раскол.{/b}"
    nvl clear

    co "Я принял решение. Нам нужно провести ритуал."
    ev "Ты сошёл с ума?"
    co "Нет. Я наконец думаю ясно. Моя прародительница знает, как снять проклятие Себастьяна. Как очистить имя отца Эвелины. Как дать ответы Теодору."
    ma "И как освободить меня от видений. Ты хотел добавить это?"
    co "..."
    ma "Я — сосуд. Ты сам это знаешь."
    th "Ритуал требует жертвы, Вейн. Ты предлагаешь убить Мэри."
    co "Я предлагаю решение. Каждое решение имеет цену."

    menu:
        "Встать на сторону Корнелиуса.":
            $ r_co += 2
            $ r_ma -= 2
            nar "— Может быть, нам стоит рассмотреть все варианты."
            ma "И ты тоже?"

        "Встать против Корнелиуса.":
            $ r_co -= 2
            $ r_ma += 3
            $ r_th += 1
            nar "— Никто не умрёт. Особенно Мэри."
            co "Тогда ты обрекаешь нас всех."

        "Потребовать найти другой путь.":
            $ r_co += 1
            $ r_ma += 1
            nar "— Пять умных людей в одной комнате. Неужели не придумаем ничего лучше?"
            th "Разумно. Но времени всё меньше."

    nvl clear
    scene bg hogwarts_night with fade
    nar "В Хогвартсе начинаются происшествия."
    nar "Русалки в озере ранены. На феникса Фоукса кто-то напал."
    nar "Директор подозревает тёмных магов."
    nar "Но это просыпается Тень. Она питается страхом."
    nar "И им всем — очень страшно."

    jump act3_arrival


# =============================================================
#  АКТ III: ПОЛУНОЧНЫЙ ЧАС (Апрель — Май)
# =============================================================

label act3_arrival:

    nvl clear
    scene bg altar_room with fade

    nar "{b}Акт III. Апрель. Полнолуние.{/b}"
    nvl clear
    nar "Они снова в той же комнате."
    nar "Но комната изменилась."
    nar "Стены покрыты плющом с шипами. В центре — каменный алтарь."
    nar "Пять свечей. Пять имён, выжженных в камне."

    nvl clear
    nar "Тень обретает форму."
    nar "Не человека — силуэт, сотканный из темноты и старых слов."

    ten "Вот и снова пятеро."
    ten "Я предлагаю вам то, чего вы хотите больше всего на свете."
    ten "Цена проста — одна жизнь на алтаре."
    nvl clear
    ten "Эвелина. Власть и чистое имя отца."
    ten "Теодор. Правда о смерти твоего отца."
    ten "Корнелиус. Сила древнего рода — вся, без остатка."
    ten "Мэри. Конец кошмарам навсегда."
    ten "Себастьян. Проклятие снято. Ты доживёшь до старости."
    nvl clear
    ten "Кто первый?"

    jump act3_choice


label act3_choice:

    # --- Секретная концовка: доступна если тайна раскрыта и доверие к Корнелиусу высокое
    if know_co and r_co >= 6:
        menu:
            "Отказать Тени. Уничтожить книгу." if r_ev + r_th + r_ma >= 7:
                jump end_redemption
            "Согласиться с Корнелиусом. Провести ритуал." if r_co >= 6:
                jump end_dark
            "Отказаться ради живого человека рядом." if romance != "" and (r_ev >= 6 or r_th >= 6 or r_ma >= 6 or r_se >= 6):
                jump end_love
            "Сдать книгу директору." if r_th >= 5 and r_ev >= 4:
                jump end_justice
            "Позволить Себастьяну принять решение." if r_se >= 7:
                jump end_chaos
            "Сказать Тени правду о Корнелиусе.":
                jump end_secret
    else:
        menu:
            "Отказать Тени. Уничтожить книгу." if r_ev + r_th + r_ma >= 7:
                jump end_redemption
            "Согласиться с Корнелиусом. Провести ритуал." if r_co >= 6:
                jump end_dark
            "Отказаться ради живого человека рядом." if romance != "" and (r_ev >= 6 or r_th >= 6 or r_ma >= 6 or r_se >= 6):
                jump end_love
            "Сдать книгу директору." if r_th >= 5 and r_ev >= 4:
                jump end_justice
            "Позволить Себастьяну принять решение." if r_se >= 7:
                jump end_chaos
            "Уничтожить книгу. Другого пути нет.":
                jump end_redemption


# =============================================================
#  КОНЦОВКИ
# =============================================================

# --- КОНЦОВКА 1: ИСКУПЛЕНИЕ ---
label end_redemption:

    nvl clear
    scene bg altar_room with dissolve

    ev "Нет."
    th "Нет."
    ma "Нет."
    se "Нет."
    co "..."
    co "Нет."

    ten "Жаль."

    nvl clear
    nar "Теодор выхватывает книгу и бросает её в огонь камина."
    nar "Тень воет. Стены трясутся. Плющ сжимается."

    ten "Цена. Всегда есть цена."

    menu:
        "Шагнуть вперёд самому.":
            nar "Тень принимает тебя молча — без боли, просто темнота."
            nar "Потом тишина."
            nvl clear
            scene bg hogwarts_dawn with fade
            nar "Четверо выходят из комнаты на рассвете."
            nar "Они никогда не говорят о том, что произошло."
            nar "Но каждый год, в самую тёмную ночь, они зажигают пятую свечу."

        "Себастьян выходит вперёд сам.":
            se "Мой род и так должен был расплатиться. Пусть долг закроется здесь."
            nar "Себастьян Морвуд исчезает вместе с Тенью."
            nar "Проклятие снято. Цена уплачена."
            nvl clear
            scene bg hogwarts_dawn with fade
            nar "Четверо выходят из комнаты. Солнце ещё не встало."
            nar "Они клянутся хранить его тайну вечно."

    nvl clear
    "{b}КОНЕЦ: ИСКУПЛЕНИЕ{/b}"
    "{i}Горькая победа. Но победа.{/i}"
    return


# --- КОНЦОВКА 2: НАСЛЕДНИКИ ТЬМЫ ---
label end_dark:

    nvl clear
    scene bg altar_room with dissolve

    co "Мэри. Ты всё равно видишь только боль. Позволь этому закончиться."
    ma "Нет... нет, пожалуйста..."

    nvl clear
    nar "Ритуал завершён."
    nar "Четверо стоят у алтаря с тёмным огнём в глазах."
    nar "Корнелиус получает силу предков."
    nar "Себастьян — свободу от проклятия."
    nar "Эвелина — имя отца очищено."
    nar "Теодор — правду."

    nvl clear
    nar "Они получили всё, чего хотели."
    nar "Пятое место за столом пустует навсегда."

    nvl clear
    scene bg hogwarts_night with fade
    nar "Мэри Олбрайт. Когтевран. Прорицательница."
    nar "Её последнее видение сбылось."

    nvl clear
    "{b}КОНЕЦ: НАСЛЕДНИКИ ТЬМЫ{/b}"
    "{i}Победа с незаживающей раной.{/i}"
    return


# --- КОНЦОВКА 3: ЛЮБОВЬ КАК ЯКОРЬ ---
label end_love:

    nvl clear
    scene bg altar_room with dissolve

    ten "Цена. Жертва. Кровь."

    nvl clear
    if romance == "ev":
        nar "Ты смотришь на Эвелину. Живую. Настоящую. Здесь."
        nar "— Эвелина."
        ev "Что?"
        nar "— Живой человек рядом важнее мёртвого призрака прошлого."
        ev "Ты... серьёзно?"
        nar "— Серьёзней некуда."
    elif romance == "th":
        nar "Ты смотришь на Теодора."
        nar "— Твой отец уже ушёл. Ты — здесь."
        th "Это нечестный аргумент."
        nar "— Знаю. Я использую всё, что у меня есть."
    elif romance == "ma":
        nar "Ты смотришь на Мэри."
        nar "— Твоё будущее — не то, что ты видишь в снах."
        ma "Ты правда веришь в это?"
        nar "— Я верю в тебя."
    elif romance == "se":
        nar "Ты смотришь на Себастьяна."
        nar "— Ты можешь умереть свободным человеком, а не рабом проклятия."
        se "Ты говоришь красивые слова."
        nar "— Только правду."

    nvl clear
    ten "...Интересно."
    nar "Тень колышется. Медленно рассеивается."
    ten "Значит, вы выбираете это."
    ten "Хорошо. Мой дар будет иным."

    nvl clear
    nar "Каждый из пятерых чувствует укол в груди — как игла сквозь сердце."
    nar "И вдруг видит мёртвых. Тех, кого любил. Тех, кого потерял."
    nar "Достаточно долго, чтобы сказать прощай."

    nvl clear
    scene bg hogwarts_dawn with fade
    nar "Тень уходит. Книга рассыпается в пыль."
    nar "Они выходят из комнаты вместе. Рука в руке."

    nvl clear
    "{b}КОНЕЦ: ЛЮБОВЬ КАК ЯКОРЬ{/b}"
    "{i}Не каждая война заканчивается победой. Эта — закончилась жизнью.{/i}"
    return


# --- КОНЦОВКА 4: РАСПЛАТА ---
label end_justice:

    nvl clear
    scene bg dumbledore with dissolve

    nar "Директор слушает долго. Не перебивает."
    nar "Затем берёт книгу двумя пальцами — как берут опасную змею."

    dir "Вы поступили правильно. Хотя и не сразу."
    dir "Эта книга будет заперта там, куда не дотянутся даже самые любопытные руки."
    th "И что теперь?"
    dir "Дверь, которую вы открыли, не закрывается полностью. Однажды кто-нибудь другой найдёт её снова."
    dir "Но это будет уже не ваша война."

    nvl clear
    nar "Он убирает книгу за портрет."
    nar "Следующим утром пятеро просыпаются без воспоминаний о Хронике."
    nar "Остаётся только смутное ощущение: они прошли через что-то важное."
    nar "И что они — не одни."

    nvl clear
    "{b}КОНЕЦ: РАСПЛАТА{/b}"
    "{i}Тихий финал. Грустный. Правильный.{/i}"
    return


# --- КОНЦОВКА 5: ВЕЧНАЯ НОЧЬ ---
label end_chaos:

    nvl clear
    scene bg altar_room with dissolve

    se "Простите."

    nar "Себастьян делает то, чего никто не ожидал."
    nar "Он не приносит в жертву кого-то из них."
    nar "Он приносит в жертву себя."

    se "Не для воскрешения. Для того, чтобы стать частью этого."
    se "Если я всё равно умру от проклятия — пусть это будет мой выбор."

    ten "Да."

    nvl clear
    nar "Себастьян исчезает. Тень поглощает его."
    nar "Замок трясётся. Время ломается."
    nar "Четверо оказываются снова в той же комнате — с книгой на пюпитре."

    nvl clear
    scene bg hogwarts_night with fade
    nar "Ноябрь. Хогвартс готовится к Рождеству..."

    ev "Нет. Нет-нет-нет. Мы уже здесь были."
    th "Временная петля."

    nvl clear
    nar "Хогвартс погружён в вечный Полуночный час."
    nar "Каждый год — одна и та же ночь."
    nar "Снова и снова."

    ten "Добро пожаловать."
    ten "Я ждала вас очень долго."

    nvl clear
    "{b}КОНЕЦ: ВЕЧНАЯ НОЧЬ{/b}"
    "{i}Некоторые двери нельзя открыть. Некоторые — нельзя закрыть.{/i}"
    return


# --- КОНЦОВКА 6 (СЕКРЕТНАЯ): ПЯТЫЙ ГОЛОС ---
label end_secret:

    nvl clear
    scene bg altar_room with dissolve

    ten "...Ты догадался."

    co "Да. Я не студент."
    co "Я никогда им не был."

    nvl clear
    nar "Корнелиус Вейн. Потомок некроманта — в буквальном смысле."
    nar "Дитя того самого ученика Слизерина, заточённое в книге вместе с Тенью."
    nar "Не живой. Не мёртвый. Застрявший между."

    co "Мне не нужны жертвы."
    co "Мне нужно ваше согласие. Четверо из вас — добровольно отдадут мне часть жизненной силы."
    co "Тогда я стану настоящим. Живым. Без тёмного прошлого."

    menu:
        "Согласиться. Все четверо вместе.":
            nar "Они берутся за руки."
            nar "Четыре жизни — и малая часть каждой перетекает к пятому."
            nar "Корнелиус падает на колени. Тело становится плотным, настоящим."
            co "Я... чувствую сердцебиение."
            co "Я никогда прежде не чувствовал сердцебиения."
            nvl clear
            nar "Тень рассеивается. Книга рассыпается."
            scene bg hogwarts_dawn with fade
            nar "Пятеро выходят из комнаты. Все пятеро."
            nvl clear
            "{b}СЕКРЕТНЫЙ КОНЕЦ: ПЯТЫЙ ГОЛОС{/b}"
            "{i}Не каждый призрак хочет мести. Некоторые просто хотят жить.{/i}"

        "Отказаться.":
            co "Понимаю."
            nar "Он исчезает — медленно, как туман на рассвете."
            nar "Книга закрывается сама."
            nar "Четверо стоят в тишине."
            jump end_redemption

    return
